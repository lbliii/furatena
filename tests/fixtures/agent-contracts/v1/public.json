{
  "fixture_version": 1,
  "profile": "public",
  "surfaces": {
    "catalog": {
      "schema_version": 3,
      "required_fields": ["node_id", "url", "title", "provenance"]
    },
    "tools": {
      "schema_version": 1,
      "access": {"visibility": "public", "include_private": false},
      "urls": {
        "catalog_url": "/catalog.json",
        "search_url": "/search.json",
        "llms_url": "/llms.txt"
      },
      "tools": [
        {"name": "semantic_search", "read_only": true},
        {"name": "diff_content_ir", "read_only": true},
        {"name": "retrieve_node", "read_only": true}
      ]
    },
    "channels": {
      "schema_version": 1,
      "outputs": [
        {"id": "catalog", "url": "/catalog.json", "visibility": "public"},
        {"id": "llms", "url": "/llms.txt", "visibility": "public"},
        {"id": "mcp", "uri": "fura://catalog/nodes", "visibility": "public"}
      ]
    },
    "deployment_profiles": {
      "schema_version": 1,
      "profiles": [
        {"id": "static-pages", "agent_modes": ["static_only"]},
        {"id": "cloud-live", "agent_modes": ["deployed_app_mcp"]}
      ]
    },
    "mcp": {
      "protocolVersion": "2025-06-18",
      "server": {"name": "furatena-catalog"},
      "resources": [
        {"uri": "fura://catalog/nodes", "name": "Catalog nodes"},
        {"uri": "fura://catalog/graph", "name": "Catalog graph"}
      ],
      "tools": [
        {"name": "semantic_search", "read_only": true},
        {"name": "diff_content_ir", "read_only": true},
        {"name": "retrieve_node", "read_only": true}
      ]
    },
    "mcp_apps": {
      "contract_version": 1,
      "spec_version": "2026-01-26",
      "extension": {
        "id": "io.modelcontextprotocol/ui",
        "mime_types": ["text/html;profile=mcp-app"]
      },
      "access": {
        "audience": "public",
        "redaction": "public-only",
        "trusted_resource_default": "deny"
      },
      "gateway": {
        "rewrite": "ui://{gateway}/{namespace}/{upstream-authority}/{app}/v1",
        "collision": "reject"
      },
      "resources": [
        {
          "uri": "ui://furatena/catalog-search/v1",
          "name": "Catalog search",
          "description": "Interactive presentation contract for public catalog search results.",
          "mimeType": "text/html;profile=mcp-app",
          "_meta": {
            "ui": {
              "csp": {
                "connectDomains": [],
                "resourceDomains": [],
                "frameDomains": [],
                "baseUriDomains": []
              },
              "permissions": {},
              "prefersBorder": true
            },
            "io.furatena/mcp-app": {
              "contractVersion": 1,
              "specVersion": "2026-01-26",
              "canonicalUri": "ui://furatena/catalog-search/v1",
              "audience": "public",
              "redaction": "public-only",
              "fallback": "structured-content"
            }
          }
        }
      ],
      "tools": [
        {
          "name": "semantic_search",
          "_meta": {
            "ui": {
              "resourceUri": "ui://furatena/catalog-search/v1",
              "visibility": ["model", "app"]
            }
          }
        }
      ]
    }
  }
}
