  "decision_policy": {
    "precedence": [
      "stop",
      "approve_one_variant",
      "continue",
      "change"
    ],
    "stop": [
      "confirmed_security_or_privacy_boundary_violation",
      "deployments_total_is_zero_at_day_90",
      "active_use_signals_zero_and_realized_earnings_zero_at_day_90",
      "support_acknowledgement_missed_in_two_consecutive_review_windows"
