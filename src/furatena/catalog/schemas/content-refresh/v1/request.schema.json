{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://furatena.dev/schemas/content-refresh/v1/request.schema.json",
  "title": "Furatena content refresh request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "expected_active_commit",
    "requested_commit",
    "idempotency_key"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "furatena.content-refresh.request"},
    "expected_active_commit": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      ]
    },
    "requested_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
    }
  }
}
