{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://furatena.dev/schemas/capability/v1/request.schema.json",
  "title": "Furatena capability request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "subject", "capability", "scope",
    "correlation_id", "evaluated_at", "plan_digest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "furatena.capability.request"},
    "subject": {"$ref": "common.schema.json#/$defs/subject"},
    "capability": {"$ref": "common.schema.json#/$defs/capability"},
    "scope": {"$ref": "common.schema.json#/$defs/scope"},
    "correlation_id": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "evaluated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "plan_digest": {"$ref": "common.schema.json#/$defs/nullableDigest"}
  }
}
