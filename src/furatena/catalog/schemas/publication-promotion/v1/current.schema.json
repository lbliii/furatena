{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://furatena.dev/schemas/publication-promotion/v1/current.schema.json",
  "title": "Furatena publication promotion current pointer v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "environment", "generation", "artifact",
    "deployment", "last_known_good", "operation_id", "updated_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "furatena.publication.promotion-current"},
    "environment": {"$ref": "common.schema.json#/$defs/deployed_environment"},
    "generation": {"type": "integer", "minimum": 1},
    "artifact": {"$ref": "common.schema.json#/$defs/artifact"},
    "deployment": {"$ref": "common.schema.json#/$defs/deployment"},
    "last_known_good": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "common.schema.json#/$defs/deployment"}
      ]
    },
    "operation_id": {"type": "string", "pattern": "^promotion-operation-[0-9a-f]{24}$"},
    "updated_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  }
}
