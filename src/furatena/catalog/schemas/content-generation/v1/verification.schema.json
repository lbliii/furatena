{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://furatena.dev/schemas/content-generation/v1/verification.schema.json",
  "title": "Furatena managed content generation verification v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "generation", "status", "manifest_digest", "artifact_count", "artifact_bytes", "checks", "actor", "operation_receipt", "verified_at"],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "furatena.content-generation.verification"},
    "generation": {"type": "string", "minLength": 1, "maxLength": 128},
    "status": {"const": "verified"},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "artifact_count": {"type": "integer", "minimum": 1},
    "artifact_bytes": {"type": "integer", "minimum": 1},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_config", "privacy_canaries", "freeze_completeness", "representative_surfaces", "artifact_integrity"],
      "properties": {
        "content_config": {"const": "pass"},
        "privacy_canaries": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "canaries", "artifacts"],
          "properties": {
            "status": {"const": "pass"},
            "canaries": {"type": "integer", "minimum": 0},
            "artifacts": {"type": "integer", "minimum": 1}
          }
        },
        "freeze_completeness": {"const": "pass"},
        "representative_surfaces": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reader", "search", "catalog", "agent"],
          "properties": {
            "reader": {"const": "pass"},
            "search": {"const": "pass"},
            "catalog": {"const": "pass"},
            "agent": {"const": "pass"}
          }
        },
        "artifact_integrity": {"const": "pass"}
      }
    },
    "actor": {"type": "string", "minLength": 1},
    "operation_receipt": {"$ref": "#/$defs/operation"},
    "verified_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation_id": {"type": "string", "pattern": "^refresh-[0-9a-f]{24}$"},
        "semantic_digest": {"$ref": "#/$defs/digest"},
        "idempotency_key_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
