{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://furatena.dev/schemas/preview-auth/v1/grant-exchange.schema.json",
  "title": "Furatena preview authorization grant exchange v1", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_type", "exchange_id", "client_kind", "code", "binding", "audience", "nonce", "exchanged_at", "redirect_uri", "code_verifier"],
  "properties": {
    "schema_version": {"const": 1}, "record_type": {"const": "furatena.preview-auth.grant-exchange"}, "exchange_id": {"$ref": "common.schema.json#/$defs/opaque"},
    "client_kind": {"enum": ["browser", "device"]}, "code": {"$ref": "common.schema.json#/$defs/oneTime"}, "binding": {"$ref": "common.schema.json#/$defs/binding"},
    "audience": {"$ref": "common.schema.json#/$defs/audience"}, "nonce": {"$ref": "common.schema.json#/$defs/oneTime"}, "exchanged_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "redirect_uri": {"oneOf": [{"$ref": "common.schema.json#/$defs/callbackUrl"}, {"type": "null"}]},
    "code_verifier": {"oneOf": [{"type": "string", "pattern": "^[A-Za-z0-9._~-]{43,128}$"}, {"type": "null"}]}
  },
  "allOf": [{"if": {"properties": {"client_kind": {"const": "browser"}}}, "then": {"properties": {"redirect_uri": {"$ref": "common.schema.json#/$defs/callbackUrl"}, "code_verifier": {"type": "string", "pattern": "^[A-Za-z0-9._~-]{43,128}$"}}}, "else": {"properties": {"redirect_uri": {"type": "null"}, "code_verifier": {"type": "null"}}}}]
}
