{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://furatena.dev/schemas/preview-auth/v1/jwks.schema.json",
  "title": "Furatena preview authorization JWKS v1", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_type", "issuer", "keys", "generated_at", "stale_after", "cache_seconds"],
  "properties": {
    "schema_version": {"const": 1}, "record_type": {"const": "furatena.preview-auth.jwks"}, "issuer": {"$ref": "common.schema.json#/$defs/endpointUrl"},
    "keys": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["kid", "alg", "use", "key_ops", "kty", "crv", "x"], "properties": {"kid": {"type": "string", "pattern": "^[A-Za-z0-9._~-]{1,128}$"}, "alg": {"const": "EdDSA"}, "use": {"const": "sig"}, "key_ops": {"const": ["verify"]}, "kty": {"const": "OKP"}, "crv": {"const": "Ed25519"}, "x": {"type": "string", "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"}}},
      {"type": "object", "additionalProperties": false, "required": ["kid", "alg", "use", "key_ops", "kty", "crv", "x", "y"], "properties": {"kid": {"type": "string", "pattern": "^[A-Za-z0-9._~-]{1,128}$"}, "alg": {"const": "ES256"}, "use": {"const": "sig"}, "key_ops": {"const": ["verify"]}, "kty": {"const": "EC"}, "crv": {"const": "P-256"}, "x": {"type": "string", "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"}, "y": {"type": "string", "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"}}}
    ]}},
    "generated_at": {"$ref": "common.schema.json#/$defs/timestamp"}, "stale_after": {"$ref": "common.schema.json#/$defs/timestamp"}, "cache_seconds": {"type": "integer", "minimum": 30, "maximum": 900}
  }
}
