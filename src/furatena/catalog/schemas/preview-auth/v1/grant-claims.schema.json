{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://furatena.dev/schemas/preview-auth/v1/grant-claims.schema.json",
  "title": "Furatena preview authorization signed grant claims v1", "type": "object", "additionalProperties": false,
  "required": ["ver", "iss", "aud", "sub", "repository_id", "pull_request_number", "head_sha", "origin", "nonce", "kid", "jti", "iat", "nbf", "exp", "scope"],
  "properties": {
    "ver": {"const": 1},
    "iss": {"$ref": "common.schema.json#/$defs/endpointUrl"}, "aud": {"$ref": "common.schema.json#/$defs/audience"}, "sub": {"type": "string", "minLength": 1, "maxLength": 256},
    "repository_id": {"type": "string", "minLength": 1, "maxLength": 256}, "pull_request_number": {"type": "integer", "minimum": 1}, "head_sha": {"$ref": "common.schema.json#/$defs/sha"},
    "origin": {"$ref": "common.schema.json#/$defs/origin"}, "nonce": {"$ref": "common.schema.json#/$defs/oneTime"}, "kid": {"type": "string", "pattern": "^[A-Za-z0-9._~-]{1,128}$"},
    "jti": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"}, "iat": {"type": "integer", "minimum": 0}, "nbf": {"type": "integer", "minimum": 0}, "exp": {"type": "integer", "minimum": 1},
    "scope": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9:_-]{0,63}$"}}
  }
}
