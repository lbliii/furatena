{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://furatena.dev/schemas/preview-auth/v1/signed-grant.schema.json",
  "title": "Furatena preview authorization compact signed grant v1", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_type", "compact"],
  "properties": {"schema_version": {"const": 1}, "record_type": {"const": "furatena.preview-auth.signed-grant"}, "compact": {"type": "string", "maxLength": 8192, "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]{85}[AQgw]$"}}
}
