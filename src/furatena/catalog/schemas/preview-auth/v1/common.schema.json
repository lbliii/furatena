{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://furatena.dev/schemas/preview-auth/v1/common.schema.json",
  "title": "Furatena preview authorization common types v1",
  "$defs": {
    "opaque": {"type": "string", "pattern": "^[A-Za-z0-9_-]{32,256}$"},
    "oneTime": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43,256}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "maxLength": 20},
    "httpsUrl": {"type": "string", "format": "uri", "minLength": 9, "maxLength": 2048, "pattern": "^https://(?:\\[[0-9a-f:]+\\]|[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?)(?::[0-9]{1,5})?(?:/[^#]*)?$"},
    "endpointUrl": {"type": "string", "format": "uri", "minLength": 9, "maxLength": 2048, "pattern": "^https://(?:\\[[0-9a-f:]+\\]|[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?)(?::[0-9]{1,5})?(?:/[^?#]*)?$"},
    "callbackUrl": {"type": "string", "format": "uri", "minLength": 9, "maxLength": 2048, "pattern": "^https://(?:\\[[0-9a-f:]+\\]|[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?)(?::[0-9]{1,5})?(?:/[^?#]*)?$"},
    "origin": {"type": "string", "format": "uri", "minLength": 9, "maxLength": 2048, "pattern": "^https://(?:\\[[0-9a-f:]+\\]|[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?)(?::[0-9]{1,5})?$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "audience": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "pull_request_number", "head_sha", "origin"],
      "properties": {
        "repository_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "pull_request_number": {"type": "integer", "minimum": 1},
        "head_sha": {"$ref": "#/$defs/sha"},
        "origin": {"$ref": "#/$defs/origin"}
      }
    },
    "lifetimes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code_seconds", "grant_seconds", "session_seconds", "jwks_cache_seconds", "clock_skew_seconds", "rollover_overlap_seconds"],
      "properties": {
        "code_seconds": {"type": "integer", "minimum": 30, "maximum": 300},
        "grant_seconds": {"type": "integer", "minimum": 60, "maximum": 600},
        "session_seconds": {"type": "integer", "minimum": 300, "maximum": 43200},
        "jwks_cache_seconds": {"type": "integer", "minimum": 30, "maximum": 900},
        "clock_skew_seconds": {"type": "integer", "minimum": 0, "maximum": 60},
        "rollover_overlap_seconds": {"type": "integer", "minimum": 600, "maximum": 86400}
      }
    },
    "nullableString": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "messageHeader": {
      "type": "object",
      "required": ["schema_version", "record_type"],
      "properties": {"schema_version": {"const": 1}}
    }
  }
}
