{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://furatena.dev/schemas/federation/v1/search-index.schema.json",
  "title": "Furatena federated shard search index",
  "oneOf": [
    {"$ref": "#/$defs/v1"},
    {"$ref": "#/$defs/v2"}
  ],
  "$defs": {
    "mount": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "edition": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "nodeId": {"type": "string", "minLength": 3, "maxLength": 1024},
    "v1Document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "title", "text"],
      "properties": {
        "node_id": {"$ref": "#/$defs/nodeId"},
        "title": {"type": "string"},
        "text": {"type": "string"}
      }
    },
    "v2Document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "title", "snippet"],
      "properties": {
        "node_id": {"$ref": "#/$defs/nodeId"},
        "title": {"type": "string"},
        "snippet": {"type": "string", "maxLength": 320}
      }
    },
    "keywordPosting": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0}
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3,
      "anyOf": [
        {"prefixItems": [{}, {"minimum": 1}]},
        {"prefixItems": [{}, {}, {"minimum": 1}]}
      ]
    },
    "tfidfPosting": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "v1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "mount", "edition", "documents"],
      "properties": {
        "schema_version": {"const": 1},
        "mount": {"$ref": "#/$defs/mount"},
        "edition": {"$ref": "#/$defs/edition"},
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/v1Document"}
        }
      }
    },
    "v2": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "idf": {"maxProperties": 0},
            "keyword_postings": {"maxProperties": 0},
            "tfidf_postings": {"maxProperties": 0}
          }
        },
        {
          "properties": {
            "idf": {"minProperties": 1},
            "keyword_postings": {"minProperties": 1},
            "tfidf_postings": {"minProperties": 1}
          }
        }
      ],
      "required": [
        "schema_version", "algorithm", "mount", "edition", "documents",
        "idf", "keyword_postings", "tfidf_postings"
      ],
      "properties": {
        "schema_version": {"const": 2},
        "algorithm": {"const": "keyword-tfidf-v1"},
        "mount": {"$ref": "#/$defs/mount"},
        "edition": {"$ref": "#/$defs/edition"},
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/v2Document"}
        },
        "idf": {
          "type": "object",
          "propertyNames": {"minLength": 1},
          "additionalProperties": {"type": "number", "exclusiveMinimum": 0}
        },
        "keyword_postings": {
          "type": "object",
          "propertyNames": {"minLength": 1},
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/keywordPosting"}
          }
        },
        "tfidf_postings": {
          "type": "object",
          "propertyNames": {"minLength": 1},
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/tfidfPosting"}
          }
        }
      }
    }
  }
}
