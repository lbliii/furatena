{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://furatena.dev/schemas/federation/v1/hub-manifest.schema.json",
  "title": "Furatena federation hub manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "manifest_type", "generated_at", "contracts", "shards",
    "channels", "discovery", "integrity", "signatures"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_type": {"const": "furatena-federation-hub"},
    "generated_at": {"type": "string", "format": "date-time"},
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "dcp_reader_min", "dcp_reader_max", "content_ir_reader_min", "content_ir_reader_max"],
      "properties": {
        "artifact": {"const": 1},
        "dcp_reader_min": {"const": 2},
        "dcp_reader_max": {"const": 3},
        "content_ir_reader_min": {"const": 3},
        "content_ir_reader_max": {"const": 3}
      }
    },
    "shards": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 10000,
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9-]{0,62}:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
      "additionalProperties": {"$ref": "#/$defs/shard"}
    },
    "channels": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1000,
      "propertyNames": {"$ref": "#/$defs/mount"},
      "additionalProperties": {"$ref": "#/$defs/channel"}
    },
    "discovery": {"$ref": "#/$defs/discovery"},
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "payload_sha256"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "payload_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/signature"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "mount": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "edition": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "dcp", "content_ir"],
      "properties": {
        "artifact": {"const": 1},
        "dcp": {"enum": [2, 3]},
        "content_ir": {"const": 3}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "release_date", "end_of_life"],
      "properties": {
        "status": {"enum": ["current", "legacy", "deprecated", "preview", "eol"]},
        "release_date": {"type": ["string", "null"], "format": "date"},
        "end_of_life": {"type": ["string", "null"], "format": "date"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "repository", "ref", "resolved_ref", "source_path"],
      "properties": {
        "provider": {"const": "git"},
        "repository": {"type": "string", "format": "uri", "pattern": "^https://"},
        "ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "resolved_ref": {"$ref": "#/$defs/gitSha"},
        "source_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"}
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "minimum_days", "pinned"],
      "properties": {
        "class": {"enum": ["moving", "release"]},
        "minimum_days": {"type": "integer", "minimum": 30},
        "pinned": {"type": "boolean"}
      }
    },
    "shard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mount", "edition", "audience", "source_shard_fingerprint", "fingerprint", "artifact_url", "lifecycle",
        "integrity", "contracts", "provenance", "retention"
      ],
      "properties": {
        "mount": {"$ref": "#/$defs/mount"},
        "edition": {"$ref": "#/$defs/edition"},
        "audience": {"const": "public"},
        "source_shard_fingerprint": {"$ref": "#/$defs/sha256"},
        "fingerprint": {"$ref": "#/$defs/sha256"},
        "artifact_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "lifecycle": {"$ref": "#/$defs/lifecycle"},
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "manifest_sha256", "manifest_bytes"],
          "properties": {
            "algorithm": {"const": "sha256"},
            "manifest_sha256": {"$ref": "#/$defs/sha256"},
            "manifest_bytes": {"type": "integer", "minimum": 2, "maximum": 4194304}
          }
        },
        "contracts": {"$ref": "#/$defs/contracts"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "retention": {"$ref": "#/$defs/retention"}
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latest", "stable", "editions"],
      "properties": {
        "latest": {"type": "string"},
        "stable": {"type": "string"},
        "editions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channels_field", "hub_manifest_url", "refresh_after_seconds",
        "max_manifest_bytes", "max_shards", "failure_mode"
      ],
      "properties": {
        "channels_field": {"const": "remote_federation"},
        "hub_manifest_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "refresh_after_seconds": {"type": "integer", "minimum": 30, "maximum": 86400},
        "max_manifest_bytes": {"type": "integer", "minimum": 1024, "maximum": 4194304},
        "max_shards": {"type": "integer", "minimum": 1, "maximum": 10000},
        "failure_mode": {"const": "last-known-good-or-unavailable"}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url", "sha256", "subject_sha256", "issuer", "identity"],
      "properties": {
        "kind": {"enum": ["sigstore-bundle", "dsse"]},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "subject_sha256": {"$ref": "#/$defs/sha256"},
        "issuer": {"type": "string", "format": "uri", "minLength": 1},
        "identity": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    }
  }
}
