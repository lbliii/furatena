{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://furatena.dev/schemas/publication-provider/v1/profile.schema.json",
  "title": "Furatena publication profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "profile", "provider_id", "repository_id",
    "target_repository_id", "base_ref", "branch_template", "review_target",
    "external_target", "allow_dirty_unrelated", "profile_digest", "extensions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "furatena.publication-provider.profile"},
    "profile": {"$ref": "common.schema.json#/$defs/profile"},
    "provider_id": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "repository_id": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "target_repository_id": {"$ref": "common.schema.json#/$defs/nullableString"},
    "base_ref": {"$ref": "common.schema.json#/$defs/nullableString"},
    "branch_template": {"$ref": "common.schema.json#/$defs/nullableString"},
    "review_target": {"$ref": "common.schema.json#/$defs/nullableString"},
    "external_target": {"$ref": "common.schema.json#/$defs/nullableString"},
    "allow_dirty_unrelated": {"type": "boolean"},
    "profile_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "extensions": {"type": "object"}
  }
}
