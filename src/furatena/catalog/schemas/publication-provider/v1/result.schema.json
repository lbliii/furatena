{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://furatena.dev/schemas/publication-provider/v1/result.schema.json",
  "title": "Furatena publication change result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "result_id", "result_digest", "request_id",
    "request_digest", "plan_digest", "change_id", "profile", "operation", "outcome",
    "provider_id", "repository_id", "observed_base_source_revision", "resulting_source_revision",
    "changed_paths", "preserved_paths", "branch_name", "commit_id", "review_id", "review_url",
    "review_state", "merge_revision", "protection", "failure", "reconciliation",
    "evidence_refs", "observed_at", "extensions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "furatena.publication-provider.result"},
    "result_id": {"type": "string", "pattern": "^provider-result-[0-9a-f]{24}$"},
    "result_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "request_id": {"type": "string", "pattern": "^provider-request-[0-9a-f]{24}$"},
    "request_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "plan_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "change_id": {"type": "string", "pattern": "^change-[0-9a-f]{24}$"},
    "profile": {"$ref": "common.schema.json#/$defs/profile"},
    "operation": {"$ref": "common.schema.json#/$defs/operation"},
    "outcome": {"$ref": "common.schema.json#/$defs/outcome"},
    "provider_id": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "repository_id": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "observed_base_source_revision": {"$ref": "common.schema.json#/$defs/digest"},
    "resulting_source_revision": {"$ref": "common.schema.json#/$defs/nullableDigest"},
    "changed_paths": {"$ref": "common.schema.json#/$defs/stringSet"},
    "preserved_paths": {"$ref": "common.schema.json#/$defs/stringSet"},
    "branch_name": {"$ref": "common.schema.json#/$defs/nullableString"},
    "commit_id": {"$ref": "common.schema.json#/$defs/nullableString"},
    "review_id": {"$ref": "common.schema.json#/$defs/nullableString"},
    "review_url": {"$ref": "common.schema.json#/$defs/nullableString"},
    "review_state": {"$ref": "common.schema.json#/$defs/reviewState"},
    "merge_revision": {"$ref": "common.schema.json#/$defs/nullableString"},
    "protection": {"$ref": "common.schema.json#/$defs/protection"},
    "failure": {"$ref": "common.schema.json#/$defs/nullableFailure"},
    "reconciliation": {"$ref": "common.schema.json#/$defs/reconciliation"},
    "evidence_refs": {"$ref": "common.schema.json#/$defs/stringSet"},
    "observed_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "extensions": {"type": "object"}
  }
}
