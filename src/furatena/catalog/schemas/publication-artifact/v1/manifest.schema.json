{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://furatena.dev/schemas/publication-artifact/v1/manifest.schema.json",
  "title": "Furatena publication artifact manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "artifact_id", "artifact_digest", "plan",
    "workflow", "approvals", "source", "validation", "policy", "configuration_digest",
    "presentation_digest", "dependency_lock_digest", "runtime_identity", "fingerprints",
    "inventory", "public_projection", "builder", "toolchain", "build_command",
    "provenance_references", "attestation_references", "actor", "correlation_id",
    "created_at", "identity_exclusions"
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifactId": {"type": "string", "pattern": "^publication-artifact-[0-9a-f]{64}$"},
    "nonEmpty": {"type": "string", "minLength": 1},
    "stringMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/nonEmpty"}
    },
    "stringSet": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonEmpty"},
      "uniqueItems": true
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "furatena.publication.artifact-manifest"},
    "artifact_id": {"$ref": "#/$defs/artifactId"},
    "artifact_digest": {"$ref": "#/$defs/digest"},
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_id", "plan_digest"],
      "properties": {
        "plan_id": {"$ref": "#/$defs/nonEmpty"},
        "plan_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "workflow": {
      "type": "object", "additionalProperties": false,
      "required": ["revision_id", "revision_digest"],
      "properties": {
        "revision_id": {"$ref": "#/$defs/nonEmpty"},
        "revision_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["record_id", "record_digest"],
        "properties": {
          "record_id": {"$ref": "#/$defs/nonEmpty"},
          "record_digest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "commit", "tree_id", "checkout", "binding_revision"],
      "properties": {
        "repository": {"$ref": "#/$defs/nonEmpty"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree_id": {"$ref": "#/$defs/nonEmpty"},
        "binding_revision": {"$ref": "#/$defs/digest"},
        "checkout": {
          "type": "object", "additionalProperties": false,
          "required": ["isolated", "detached", "clean"],
          "properties": {
            "isolated": {"const": true},
            "detached": {"const": true},
            "clean": {"const": true}
          }
        }
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "snapshot_id", "diagnostics_digest"],
      "properties": {
        "run_id": {"$ref": "#/$defs/nonEmpty"},
        "snapshot_id": {"$ref": "#/$defs/nonEmpty"},
        "diagnostics_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "digest"],
      "properties": {
        "version": {"$ref": "#/$defs/nonEmpty"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "configuration_digest": {"$ref": "#/$defs/digest"},
    "presentation_digest": {"$ref": "#/$defs/digest"},
    "dependency_lock_digest": {"$ref": "#/$defs/digest"},
    "runtime_identity": {"$ref": "#/$defs/stringMap"},
    "fingerprints": {
      "type": "object", "additionalProperties": false,
      "required": ["content_ir", "frozen", "renderer", "theme", "catalog", "mount", "channel", "edition"],
      "properties": {
        "content_ir": {"$ref": "#/$defs/digest"},
        "frozen": {"$ref": "#/$defs/digest"},
        "renderer": {"$ref": "#/$defs/digest"},
        "theme": {"$ref": "#/$defs/digest"},
        "catalog": {"$ref": "#/$defs/digest"},
        "mount": {"$ref": "#/$defs/digest"},
        "channel": {"$ref": "#/$defs/digest"},
        "edition": {"$ref": "#/$defs/digest"}
      }
    },
    "inventory": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "media_type", "bytes", "sha256"],
        "properties": {
          "path": {"$ref": "#/$defs/nonEmpty"},
          "media_type": {"$ref": "#/$defs/nonEmpty"},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "public_projection": {
      "type": "object", "additionalProperties": false,
      "required": ["inventory", "privacy_scan"],
      "properties": {
        "inventory": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {
            "type": "array", "minItems": 1,
            "items": {"$ref": "#/$defs/nonEmpty"}, "uniqueItems": true
          }
        },
        "privacy_scan": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "canaries", "artifacts"],
          "properties": {
            "status": {"const": "pass"},
            "canaries": {"type": "integer", "minimum": 0},
            "artifacts": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "builder": {"$ref": "#/$defs/stringMap"},
    "toolchain": {"$ref": "#/$defs/stringMap"},
    "build_command": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmpty"}},
    "provenance_references": {"$ref": "#/$defs/stringSet"},
    "attestation_references": {"$ref": "#/$defs/stringSet"},
    "actor": {
      "type": "object", "additionalProperties": false,
      "required": ["actor", "identity_source", "roles", "teams"],
      "properties": {
        "actor": {"$ref": "#/$defs/nonEmpty"},
        "identity_source": {"$ref": "#/$defs/nonEmpty"},
        "roles": {"$ref": "#/$defs/stringSet"},
        "teams": {"$ref": "#/$defs/stringSet"}
      }
    },
    "correlation_id": {"$ref": "#/$defs/nonEmpty"},
    "created_at": {"type": "string", "format": "date-time"},
    "identity_exclusions": {
      "type": "array",
      "prefixItems": [
        {"const": "created_at"},
        {"const": "provenance_references"},
        {"const": "attestation_references"}
      ],
      "items": false
    }
  }
}
