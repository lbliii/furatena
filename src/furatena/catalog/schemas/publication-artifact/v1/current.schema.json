{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://furatena.dev/schemas/publication-artifact/v1/current.schema.json",
  "title": "Furatena current publication artifact pointer v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "artifact_id", "artifact_digest",
    "manifest_digest", "source_commit", "generation", "updated_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "furatena.publication.current-artifact"},
    "artifact_id": {"type": "string", "pattern": "^publication-artifact-[0-9a-f]{64}$"},
    "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "generation": {"type": "integer", "minimum": 1},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
