{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://furatena.dev/schemas/publication/v1/decision.schema.json",
  "title": "Furatena publication decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "decision_id", "decision_digest", "plan_digest",
    "policy_digest", "actor", "decision", "reason", "diagnostic_ids", "timestamp",
    "expires_at", "extensions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "furatena.publication.decision"},
    "decision_id": {"type": "string", "pattern": "^decision-[0-9a-f]{24}$"},
    "decision_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "plan_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "policy_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "actor": {"$ref": "common.schema.json#/$defs/actor"},
    "decision": {
      "enum": [
        "approve", "reject", "request_changes", "revoke", "waive_warning",
        "emergency_override", "expire", "supersede"
      ]
    },
    "reason": {"type": "string"},
    "diagnostic_ids": {"$ref": "common.schema.json#/$defs/stringSet"},
    "timestamp": {"$ref": "common.schema.json#/$defs/timestamp"},
    "expires_at": {"$ref": "common.schema.json#/$defs/nullableTimestamp"},
    "extensions": {"$ref": "common.schema.json#/$defs/extensions"}
  }
}
