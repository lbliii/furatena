{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lbliii/furatena/blob/main/.github/schemas/private-image-promotion-evidence-v1.schema.json",
  "title": "Furatena private-image promotion evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "image",
    "digest",
    "subject",
    "source_commit",
    "source_ref",
    "workflow_repository",
    "workflow_path",
    "workflow_ref",
    "workflow_sha",
    "run_id",
    "run_attempt",
    "run_url",
    "conclusion",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "furatena.private-image.promotion-evidence"},
    "image": {"type": "string", "pattern": "^ghcr\\.io/[a-z0-9][a-z0-9._/-]*[a-z0-9]$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "subject": {"type": "string", "pattern": "^ghcr\\.io/[a-z0-9][a-z0-9._/-]*[a-z0-9]@sha256:[0-9a-f]{64}$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_ref": {"const": "refs/heads/main"},
    "workflow_repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "workflow_path": {"const": ".github/workflows/private-image.yml"},
    "workflow_ref": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/\\.github/workflows/private-image\\.yml@refs/heads/main$"},
    "workflow_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "run_id": {"type": "integer", "minimum": 1},
    "run_attempt": {"type": "integer", "minimum": 1},
    "run_url": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/actions/runs/[1-9][0-9]*$"},
    "conclusion": {"const": "success"},
    "recorded_at": {"type": "string", "format": "date-time"}
  }
}
